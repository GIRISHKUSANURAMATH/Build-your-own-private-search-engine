# Copy this file to .env and adjust. Never commit .env.
APP_NAME=PySearch
ENVIRONMENT=development

# Relative paths resolve against the project root (the folder containing backend/ and frontend/)
DATABASE_PATH=data/pysearch.db

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Crawler limits (used from Phase 9)
MAX_PAGES=50
MAX_DEPTH=2
REQUEST_DELAY=1.0
REQUEST_TIMEOUT=10
ALLOWED_DOMAINS=
MAX_RETRIES=2
MAX_CONTENT_BYTES=5242880
USER_AGENT=PySearchBot/0.1 (+private, educational crawler)
RESPECT_ROBOTS_TXT=true
# Refuse private/loopback addresses (SSRF protection). Only set true to crawl your own LAN/localhost site.
ALLOW_PRIVATE_NETWORKS=false
